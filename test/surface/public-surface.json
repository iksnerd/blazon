  "pluginProtocol": {
    "v": 1,
    "host": "blazon",
    "check_command": "blazon plugin check",
    "roles": [
      {
        "name": "check",
        "exit_codes": {
          "0": "an answer: the findings",
          "2": "cannot answer, with the reason as the first line"
        },
        "breaker": true,
        "stdout_limit_bytes": 1048576
      },
      {
        "name": "build",
        "exit_codes": {
          "0": "an answer: the plugin wrote its files to out_dir",
          "2": "cannot answer, with the reason as the first line"
        },
        "breaker": true
      }
    ],
    "adopts": [],
    "secret_env_prefixes": [
      "BLAZON_SECRET_"
    ],
    "request_cap_bytes": 4194304
