{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RFC 0010 candidate host profile document",
  "description": "Shape only. That a number tightens a core rule, that a role is behind the breaker, and that the document equals the host's behaviour are the host's tests (RFC 0010 section 5).",
  "$defs": {
    "role": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$(?!\\n)"
        },
        "exit_codes": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "0",
              "1",
              "2"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "required": [
            "0"
          ]
        },
        "breaker": {
          "type": "boolean"
        },
        "pinned": {
          "enum": [
            "always",
            "by_rule"
          ]
        },
        "timeout_cap_ms": {
          "type": "integer",
          "minimum": 1
        },
        "stdout_limit_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "exit_codes"
      ]
    },
    "kindVersion": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "schema": {
          "type": "string",
          "pattern": "^[^/:][^:]*$(?!\\n)"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?!\\n)"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$(?!\\n)"
          }
        }
      },
      "required": [
        "version",
        "schema",
        "digest",
        "description"
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$(?!\\n)"
        },
        "check_command": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "adopts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "0003",
              "0004",
              "0005",
              "0006",
              "0007",
              "0008",
              "0009",
              "0012"
            ]
          }
        },
        "secret_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(/[^/]*)*$(?!\\n)"
          }
        },
        "secret_env_prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "subjects": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "request_cap_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "kinds": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$(?!\\n)",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/kindVersion"
            }
          }
        }
      },
      "required": [
        "v",
        "host",
        "check_command",
        "roles"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "adopts"
            ],
            "properties": {
              "adopts": {
                "contains": {
                  "const": "0007"
                }
              }
            }
          },
          "then": {
            "properties": {
              "adopts": {
                "contains": {
                  "const": "0003"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "adopts"
            ],
            "properties": {
              "adopts": {
                "contains": {
                  "const": "0008"
                }
              }
            }
          },
          "then": {
            "properties": {
              "adopts": {
                "contains": {
                  "const": "0007"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "adopts"
            ],
            "properties": {
              "adopts": {
                "contains": {
                  "const": "0012"
                }
              }
            }
          },
          "then": {
            "required": [
              "kinds"
            ]
          }
        }
      ]
    }
  }
}
