{
  "about": "A one-shot command may run a must-pin plugin the operator names, unpinned, with a warning.",
  "rfc": "3.6",
  "manifest": {
    "v": 2,
    "roles": [
      "$role"
    ],
    "env": [
      "TOKEN"
    ],
    "secret_env": [
      "TOKEN"
    ]
  },
  "labels": {
    "env": [
      "TOKEN"
    ],
    "fields": [],
    "delegated": []
  },
  "marked_fields": [],
  "pinned": false,
  "mode": "one-shot-named",
  "flows": {
    "returns_secret": false,
    "authorizes": false
  },
  "expect": {
    "admit": true,
    "warn": true
  }
}
