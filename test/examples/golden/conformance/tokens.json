{
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#14213D",
      "$description": "Approved, and the fingerprint matches: no finding (the value is filled in below)",
      "$extensions": {
        "dev.blazon": {
          "review": {
            "status": "ok",
            "by": "Example Approver",
            "at": "2026-01-15",
            "value": "cb387c4533ef",
            "note": "Fictional approval for the conformance fixture"
          }
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#E4572E",
      "$description": "Approved against an older value: approval-stale",
      "$extensions": {
        "dev.blazon": {
          "review": {
            "status": "ok",
            "by": "Example Approver",
            "at": "2026-01-15",
            "value": "000000000000"
          }
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#FAF7F2",
      "$description": "Approved with no fingerprint: never stale",
      "$extensions": {
        "dev.blazon": {
          "review": {
            "status": "ok",
            "by": "Example Approver",
            "at": "2026-01-15"
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Example Display",
          "sans-serif"
        ],
        "$description": "A listed SPDX id, with a source and a license page: no finding",
        "$extensions": {
          "dev.blazon": {
            "font": {
              "source": "https://fonts.example.invalid/example-display",
              "license": "OFL-1.1",
              "licenseUrl": "https://openfontlicense.org/"
            }
          }
        }
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Example Text",
          "sans-serif"
        ],
        "$description": "A license that looks like an SPDX id and is not one: font-license-unknown",
        "$extensions": {
          "dev.blazon": {
            "font": {
              "source": "Example Foundry",
              "license": "OFL-1.2"
            }
          }
        }
      }
    }
  }
}
