{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "blazon brand.json",
  "description": "The whole brand in one file (blazon RFC 0001, section 12). A reader checks `format` and `version`, and ignores keys it does not know: this schema allows them. `file` and `dir` are paths beside brand.json; `sourceFile` names a project file that is not shipped.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The schema this file follows, as a path beside it."
    },
    "format": {
      "const": "blazon-brand"
    },
    "version": {
      "const": 2
    },
    "generator": {
      "type": "object",
      "description": "Which blazon wrote this file. No timestamp or host, so the file stays the same for the same inputs and blazon.",
      "properties": {
        "name": {
          "const": "blazon"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The blazon commit, when blazon can say it; omitted otherwise."
        },
        "dirty": {
          "type": "boolean",
          "description": "True when that blazon had changes that were not committed. Present only with commit."
        }
      },
      "required": [
        "name"
      ]
    },
    "brand": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ]
    },
    "theme": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fontLicenses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1
              },
              "licenseFile": {
                "type": "string",
                "minLength": 1
              },
              "licenseText": {
                "type": "string",
                "maxLength": 65536
              }
            },
            "required": [
              "family",
              "licenseFile",
              "licenseText"
            ]
          }
        }
      },
      "required": [
        "roles",
        "tokens",
        "fonts"
      ]
    },
    "logo": {
      "type": "object",
      "properties": {
        "onLight": {
          "$ref": "#/$defs/logoFile"
        },
        "onDark": {
          "$ref": "#/$defs/logoFile"
        },
        "onLightInk": {
          "type": "string",
          "minLength": 1
        },
        "onDarkInk": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "vocabulary": {
      "$ref": "#/$defs/vocabulary"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sectionInfo"
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modifier"
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "iconSets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/iconSet"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "required": [
    "format",
    "version",
    "generator",
    "brand",
    "theme",
    "logo",
    "vocabulary",
    "sections",
    "tokens",
    "groups",
    "modifiers",
    "contexts",
    "pages",
    "assets",
    "categories",
    "iconSets",
    "findings"
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
      "description": "A path beside brand.json, with forward slashes: no scheme, not absolute, no '..' segment."
    },
    "dimension": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "px",
            "rem"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ]
    },
    "measure": {
      "description": "A dimension, or a multiple of the artwork's unit.",
      "oneOf": [
        {
          "$ref": "#/$defs/dimension"
        },
        {
          "type": "object",
          "properties": {
            "units": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "units"
          ]
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        }
      },
      "required": [
        "doc",
        "locator"
      ]
    },
    "tokenSource": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "cssVar": {
          "type": "string",
          "pattern": "^--"
        }
      },
      "required": [
        "doc",
        "locator"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ok",
            "needs-review"
          ]
        },
        "note": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "value": {
          "type": "string",
          "description": "The fingerprint of the confirmed value: 12 lowercase hex digits (RFC 0001, section 2).",
          "pattern": "^[0-9a-f]{12}$"
        }
      },
      "required": [
        "status"
      ]
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blazon": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "print": {
          "type": "object",
          "properties": {
            "cmyk": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "pms": {
              "type": "string"
            },
            "ral": {
              "type": "string"
            }
          }
        },
        "source": {
          "$ref": "#/$defs/tokenSource"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "logo": {
          "type": "object",
          "properties": {
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "angle": {
          "type": "number"
        },
        "preview": {
          "type": "string"
        },
        "font": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "licenseUrl": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "webFont": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "proportion": {
          "type": "object",
          "additionalProperties": true
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fg": {
                "type": "string"
              },
              "bg": {
                "type": "string"
              },
              "min": {
                "type": "string"
              }
            },
            "required": [
              "fg",
              "bg",
              "min"
            ]
          }
        },
        "pattern": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "token": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "resolvedValue": true,
        "rawValue": true,
        "parts": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "aliasOf": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "deprecated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "cssVariable": {
          "type": "string"
        },
        "sourceFile": {
          "type": "string",
          "description": "The project file the token was authored in. Not shipped beside brand.json."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "blazon": {
          "$ref": "#/$defs/blazon"
        },
        "file": false
      },
      "required": [
        "path",
        "value",
        "resolvedValue",
        "rawValue",
        "cssVariable",
        "sourceFile"
      ]
    },
    "group": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "blazon": {
          "$ref": "#/$defs/blazon"
        }
      },
      "required": [
        "path",
        "blazon"
      ]
    },
    "modifier": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "default",
        "contexts"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "modifier": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "metadataChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "removed": {
          "description": "The paths of the default's tokens this context leaves out, sorted. Apply them after `tokens` and `metadataChanges`.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groupChanges": {
          "description": "The groups whose description or rules differ from the default's, or that only this context has: each is the context's whole record for that group.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "removedGroups": {
          "description": "The paths of the default's groups that carry no description or rules in this context, sorted.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "modifier",
        "context",
        "selector",
        "tokens"
      ]
    },
    "page": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "sourceFile": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "meta": {
          "type": "object",
          "additionalProperties": true
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sectionId"
          },
          "uniqueItems": true
        },
        "markdown": {
          "type": "string"
        },
        "directives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "args"
            ]
          }
        },
        "file": false
      },
      "required": [
        "slug",
        "sourceFile",
        "title",
        "order",
        "meta",
        "sections",
        "markdown",
        "directives"
      ]
    },
    "assetMeta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "traits": {
          "$ref": "#/$defs/stringList"
        },
        "do": {
          "$ref": "#/$defs/stringList"
        },
        "dont": {
          "$ref": "#/$defs/stringList"
        },
        "background": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "ink": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "$ref": "#/$defs/dimension"
        },
        "clearSpace": {
          "$ref": "#/$defs/measure"
        },
        "minSize": {
          "type": "object",
          "properties": {
            "width": {
              "$ref": "#/$defs/dimension"
            },
            "height": {
              "$ref": "#/$defs/dimension"
            }
          }
        },
        "maxSize": {
          "type": "object",
          "properties": {
            "width": {
              "$ref": "#/$defs/dimension"
            },
            "height": {
              "$ref": "#/$defs/dimension"
            }
          }
        },
        "replacedBelow": {
          "type": "object",
          "properties": {
            "width": {
              "$ref": "#/$defs/dimension"
            },
            "height": {
              "$ref": "#/$defs/dimension"
            },
            "by": {
              "type": "string"
            }
          },
          "required": [
            "by"
          ]
        },
        "lockup": {
          "$ref": "#/$defs/name"
        },
        "misuse": {
          "type": "array",
          "items": {
            "enum": [
              "stretch",
              "squash",
              "rotate",
              "outline",
              "recolor",
              "shadow",
              "crop",
              "low-contrast",
              "busy-background"
            ]
          }
        },
        "placement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "top-left",
              "top-right",
              "bottom-left",
              "bottom-right"
            ]
          }
        },
        "partnership": {
          "type": "object",
          "properties": {
            "gap": {
              "$ref": "#/$defs/measure"
            },
            "dividerHeight": {
              "$ref": "#/$defs/measure"
            },
            "partnerHeight": {
              "$ref": "#/$defs/measure"
            }
          },
          "required": [
            "gap"
          ]
        },
        "initiative": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "mark": {
              "type": "string"
            },
            "gap": {
              "$ref": "#/$defs/measure"
            },
            "position": {
              "enum": [
                "beside",
                "below"
              ]
            },
            "markHeight": {
              "$ref": "#/$defs/measure"
            }
          },
          "required": [
            "name",
            "mark",
            "gap"
          ]
        },
        "order": {
          "type": "number"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "generated": {
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string"
            },
            "licence": {
              "type": "string"
            }
          },
          "required": [
            "by"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/relativePath"
        },
        "format": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "bytes": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "meta": {
          "$ref": "#/$defs/assetMeta"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "file",
        "format",
        "mediaType",
        "bytes"
      ]
    },
    "category": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "description": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "properties": {
            "formats": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "svg",
                  "png",
                  "jpg",
                  "gif",
                  "webp",
                  "avif"
                ]
              }
            },
            "minPixels": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "aspectRatios": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?:\\d+(\\.\\d+)?$"
              }
            }
          }
        },
        "notSpecified": {
          "$ref": "#/$defs/stringList"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "local": {
          "type": "string",
          "minLength": 1
        },
        "experimental": {
          "const": true
        },
        "reference": {
          "const": true
        }
      },
      "required": [
        "category",
        "label"
      ]
    },
    "iconSet": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "icons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "icons"
            ]
          }
        },
        "dir": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "required": [
        "name",
        "package",
        "count",
        "categories",
        "dir"
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "description": "The file the finding is about, relative to the project, when path names a token or an asset."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "The line (1-based) in file where the key of the token that path names is written; for token-file-invalid, the line where the parser stopped. Absent when it is not known."
        },
        "fix": {
          "type": "string",
          "description": "What to do about this finding, when it differs from the fix of its code: a plugin-failed finding carries the fix for its own cause."
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ]
    },
    "logoFile": {
      "description": "A path beside brand.json, or the image embedded as a data URI when it is not an asset.",
      "anyOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "type": "string",
          "pattern": "^data:image/"
        }
      ]
    },
    "sectionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "A standard section, or one the brand added: listed in `sections`."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
