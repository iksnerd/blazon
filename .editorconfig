# https://editorconfig.org: the basics every editor can follow without a plugin. Prettier reads this file as well.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown ends a line with two spaces on purpose
[*.md]
trim_trailing_whitespace = false

[*.{py,sh}]
indent_size = 4

[.githooks/*]
indent_size = 4
