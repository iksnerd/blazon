{
  "name": "@iksnerd/blazon",
  "version": "0.4.0",
  "description": "Brand book and design token compiler: DTCG tokens, brand rules checked by blazon check, a static brand book that wears the brand",
  "type": "module",
  "bin": {
    "blazon": "./bin/blazon.js",
    "blazon-mcp": "./mcp/dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "bin",
    "mcp/dist/index.js",
    "plugins",
    "template",
    "THIRD-PARTY-NOTICES.md"
  ],
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build -c vite.viewer.config.ts && npm run build:plugins && npm run build:mcp",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:plugins": "tsx scripts/build-plugins.mjs && tsx scripts/shipped-lock.mjs",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "test:files": "vitest run",
    "test:guards": "vitest run test/core/no-private-markers.test.ts test/core/layers.test.ts",
    "test:deck": "vitest run test/deck/brand-deck-plan test/deck/brand-deck-fonts.test.ts test/deck/brand-deck-examples.test.ts test/deck/examples-deck.test.ts test/plugins/shipped/brand-deck test/brand/brand-python.test.ts",
    "test:docs": "vitest run test/docs/manual.test.ts test/docs/rfc.test.ts test/docs/checks-generated.test.ts test/docs/layers-generated.test.ts test/docs/versions.test.ts test/docs/changelog-fragments.test.ts",
    "conformance:reads": "rm -f reads.json reads.json.lines && CONFORMANCE_READS=reads.json vitest run test/plugins/host && tsx scripts/conformance-reads.ts reads.json",
    "test:watch": "vitest",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit && node scripts/typecheck-mcp.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:files": "eslint --no-warn-ignored",
    "lint:py": "uvx ruff check scripts test/deck/python",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:files": "prettier --check --no-error-on-unmatched-pattern",
    "check": "npm run typecheck && npm run lint && npm run lint:py && npm run format:check",
    "checks-docs": "tsx scripts/gen-checks-docs.ts",
    "layers-docs": "tsx scripts/gen-layers-docs.ts",
    "docs:stats": "tsx scripts/docs-stats.ts",
    "gen:mcp": "tsx scripts/gen-mcp-operations.ts",
    "shipped-lock": "tsx scripts/shipped-lock.mjs",
    "build-starter": "tsx scripts/build-starter.ts",
    "check-pack": "node scripts/check-pack.mjs",
    "prepack": "npm run build && npm run build-starter",
    "prepublishOnly": "npm run prepack && npm run check-pack",
    "release": "node scripts/release.mjs",
    "changelog:preview": "node scripts/release.mjs --preview",
    "blazon:src": "tsx scripts/blazon-src.ts",
    "build:viewer": "vite build -c vite.viewer.config.ts",
    "dev:blazon": "tsx scripts/blazon-src.ts dev examples/blazon",
    "hooks": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "cac": "^7.1.0",
    "colorjs.io": "^0.7.1",
    "gray-matter": "^4.0.3",
    "image-size": "^2.1.0",
    "marked": "^18.2.0",
    "pdf-lib": "^1.17.1",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.65.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "input-otp": "^1.5.0",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.72.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "brandbook",
    "design-tokens",
    "design-system",
    "vite",
    "cli",
    "tokens",
    "documentation"
  ],
  "author": "iksnerd <me@iksnerd.xyz> (https://github.com/iksnerd)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iksnerd/blazon.git"
  },
  "bugs": {
    "url": "https://github.com/iksnerd/blazon/issues"
  },
  "homepage": "https://github.com/iksnerd/blazon#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0",
    "minimatch": "^11.0.1",
    "pptxgenjs": {
      "image-size": "$image-size"
    }
  }
}
