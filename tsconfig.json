{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/viewer/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "vite.viewer.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
